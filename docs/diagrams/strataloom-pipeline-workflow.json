    },
    {
      "id": "e-gate",
      "from": "capture_l0",
      "to": "gate_chain",
      "label": "闸门链判定"
    },
    {
      "id": "e-enq",
      "from": "gate_chain",
      "to": "enq_extract",
      "label": "四项全通过",
      "variant": "emphasis"
    },
    {
      "id": "e-tick",
      "from": "tick_timer",
      "to": "singleflight",
      "label": "30 秒到期"
    },
    {
      "id": "e-sf",
      "from": "singleflight",
      "to": "iterate",
      "label": "未运行则放行"
    },
    {
      "id": "e-maint",
      "from": "iterate",
      "to": "maint_gate",
      "label": "先做维护"
    },
    {
      "id": "e-metrics",
      "from": "maint_gate",
      "to": "collect_metrics",
      "label": "是 · 先采指标",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "e-metrics-on",
      "from": "collect_metrics",
      "to": "cleanup_jobs",
