  "cards": [
    {
      "dot": "cyan",
      "title": "两个写入口，一条不变量",
      "items": [
        "工具路径走 commitL1Mutation，job 路径走 commitClaimedJob",
        "“每次写入都成立”的不变量不能靠“记得调用”来保证",
        "必须下沉到 schema 层强制执行"
      ]
    },
    {
      "dot": "violet",
      "title": "reconcile 的三条硬规则",
      "items": [
        "preference 永不被 supersede",
        "derived 目标不可 supersede",
        "procedure 被覆盖时转 archived 而非 superseded"
      ]
    },
    {
      "dot": "orange",
      "title": "rebuild 的双重围栏",
      "items": [
        "precheck：revision 不等即空提交，不烧 LLM",
        "提交内再查一次 revision，然后删派生层、插 ≤6 块",
        "global 库走 L3 画像，模型可裁决 keep（keep 则不写）"
      ]
    },
    {
      "dot": "emerald",
      "title": "围栏先于业务写入",
      "items": [
        "租约丢失即零写入回滚",
        "崩溃与正常退出共用一条恢复路径"
      ]
    },
    {
      "dot": "amber",
      "title": "认领即消耗预算",
      "items": [
        "每个 store 每 tick 最多认领 1 个 job",
        "attempts 在认领时自增，而非完成时",
        "崩溃的 worker 同样消耗重试预算"
      ]
    }
  ]
}