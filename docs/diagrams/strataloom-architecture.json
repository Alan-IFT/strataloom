  "cards": [
    {
      "dot": "cyan",
      "title": "两条正交的轴",
      "items": [
        "derived 列 0/1/2/3 是粒度轴：raw → rollup → 场景块 → 画像",
        "fact/coding/preference/procedure 是用途轴，只在 raw 层有意义",
        "L2/L3 曾被初始规范三次否决，ADR 0002 定死边界后才重开"
      ]
    },
    {
      "dot": "violet",
      "title": "一条规则一个实现",
      "items": [
        "三条读出口共用 renderEntry，预算口径同源（D8）",
        "派生层失效下沉为 schema v5 的三个触发器，不靠写入方记得清理（D9）",
        "job 复活规则只写在唯一入队点，所有 kind 共享一条规则"
      ]
    },
    {
      "dot": "amber",
      "title": "边界与失败姿态",
      "items": [
        "身份、scope 只从平台事实派生，模型与调用者不得声明（D1）",
        "fencing 先于业务写入：租约丢失即零写入回滚（D6）",
        "采集失败 fail open：绝不打断 turn 边界"
      ]
    }
  ]
