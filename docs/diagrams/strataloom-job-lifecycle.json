  "cards": [
    {
      "dot": "cyan",
      "title": "关键常量",
      "items": [
        "MAX_CLAIMS = 5：认领上限，超出即判定为毒 job",
        "LEASE_DURATION_MS = 5 分钟：单次认领的租约时长",
        "JOB_TIMEOUT_MS = 4 分钟：小于租约，所以 worker 先被 abort",
        "RETRY_BACKOFF_MS = 60s × attempts：线性退避",
        "TICK_INTERVAL_MS = 30s；CLEANUP_INTERVAL_MS = 6 小时"
      ]
    },
    {
      "dot": "emerald",
      "title": "三条不变式",
      "items": [
        "attempts 在认领时自增而非完成时：崩溃的 worker 也消耗预算，这是毒 job 防线",
        "commitClaimedJob 是唯一成功出口；failClaimedJob 是唯一失败出口，也是 last_error 的唯一写点",
        "所有出口 CAS 都带 state='running' AND lease_token=?；租约丢失则出口变 no-op"
      ]
    },
    {
      "dot": "amber",
      "title": "两类静默 no-op",
      "items": [
        "pending / running / done 遇同键重触发：被主键静默吸收，状态不变",
        "running 遇 FencingError（租约丢失）：零业务写入、job 行不动、不消耗重试预算",
        "FencingError 只由 runner 记一条 info 日志"
      ]
    },
    {
      "dot": "violet",
      "title": "四个 kind 共享同一状态机",
      "items": [
        "extract / reconcile / decay / rebuild 走完全相同的迁移规则",
        "rebuild 多一条清理：kind='rebuild' 且 payload.expectedRevision ≠ 当前 store_revision",
        "该清理与年龄无关，直接删除已不可达的 failed 行"
      ]
    }
  ]
