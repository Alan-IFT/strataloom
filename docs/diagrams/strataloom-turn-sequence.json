  "cards": [
    {
      "dot": "cyan",
      "title": "一个渲染器，三份预算",
      "items": [
        "注入、recall、跨仓成员三条读出口（注入 / recall / propose 近重复列表）共用同一个渲染器（D8）",
        "预算各自独立：注入正文 1300 tok / recall home 500 tok / 每个跨仓成员 220 tok",
        "personal 侧另有 171 tok 帽子，容器上限 1400 tok"
      ]
    },
    {
      "dot": "amber",
      "title": "注入路径没有查询串",
      "items": [
        "注入取的是工作集 top-N，不是逐轮检索",
        "派生行优先，为空才回落 raw 工作集，LIMIT 20",
        "openIfMissing=false：注入路径不得开库"
      ]
    },
    {
      "dot": "rose",
      "title": "权限由平台事实派生（D1）",
      "items": [
        "写操作 principal-only：isLiveAgent ∧ isLineagePrincipal",
        "注入只给 principal，subagent 不接受注入",
        "subagent 只能主动调用 memory_recall 自取"
      ]
    }
  ]
