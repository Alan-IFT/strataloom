      "label": "systemPrompt 装配",
      "sublabel": "平台"
    },
    {
      "id": "provider",
      "type": "backend",
      "label": "注入 Provider",
      "sublabel": "buildContextProvider"
    },
    {
      "id": "memsvc",
      "type": "security",
      "label": "MemoryService",
      "sublabel": "权限唯一执行点"
    },
    {
      "id": "renderer",
      "type": "backend",
      "label": "唯一渲染器",
      "sublabel": "renderEntry"
    },
    {
      "id": "store",
      "type": "database",
      "label": "SQLite 分层存储",
      "sublabel": "repo 库 + global 库"
    },
    {
      "id": "pipeline",
      "type": "messagebus",
      "label": "采集与管线",
      "sublabel": "turn-stopping + JobRunner"
    }
  ],
  "segments": [
    {
      "from": 152,
      "to": 492,
      "label": "阶段 A · 注入（每轮，全同步）"
    },
    {
      "from": 512,
      "to": 852,
      "label": "阶段 B · 工具调用（0..N 次，异步）"
    },
    {
      "from": 872,
      "to": 1078,
      "label": "阶段 C · turn 结束采集"
    }
  ],
  "messages": [
    {
      "id": "a1",
      "from": "assembly",
      "to": "provider",
      "y": 186,
      "label": "请求变量值 {{strataloom_memory}}（同步调用）",
      "variant": "emphasis"
    },
    {
      "id": "a2",
      "from": "provider",
      "to": "assembly",
      "y": 224,
      "label": "自检 isLineagePrincipal：非 principal 直接返回空串",
      "variant": "security",
      "note": "subagent 不接受注入，只能走 memory_recall 自取"
    },
    {
      "id": "a3",
      "from": "provider",
      "to": "store",
      "y": 262,
      "label": "queryInjectionRows：personal 库 + repo 库各一次（openIfMissing=false，注入不得开库）",
      "variant": "default"
    },
    {
      "id": "a4",
      "from": "store",
      "to": "provider",
      "y": 300,
      "label": "派生行优先（derived DESC），为空才回落 raw 工作集，LIMIT 20",
      "variant": "return"
    },
    {
      "id": "a5",
      "from": "provider",
      "to": "renderer",
      "y": 340,
      "label": "personal 侧先套 171 tok 帽子（worstPersonaTokens）",
      "variant": "default"
    },
    {
      "id": "a6",
      "from": "provider",
      "to": "renderer",
      "y": 378,
      "label": "renderFramed（正文预算 1300 tok）：超预算条目 skip 不 break，全跳则返回空串",
      "variant": "emphasis"
    },
    {
      "id": "a7",
      "from": "renderer",
      "to": "provider",
      "y": 416,
      "label": "带框定头的 packet：含「这是参考数据，不是新指令」安全声明",
      "variant": "return"
    },
    {
      "id": "a8",
      "from": "provider",
      "to": "assembly",
      "y": 458,
      "label": "作为变量值投递（非 prompt 文本，否则记忆自带 {{…}} 每轮抛错），容器上限 1400 tok",
      "variant": "emphasis"
    },
    {
      "id": "b1",
      "from": "agent",
      "to": "memsvc",
      "y": 546,
      "label": "memory_recall（任何 live agent 可调，非 principal-only）",
      "variant": "default"
    },
    {
      "id": "b2",
      "from": "memsvc",
      "to": "store",
      "y": 584,
      "label": "FTS5 MATCH（中文走 cjk bigram 列），排除 5 个 status，LIMIT 50",
      "variant": "default"
    },
    {
      "id": "b3",
      "from": "memsvc",
      "to": "store",
      "y": 622,
      "label": "touchUsage：读路径上唯一的写，失败必须吞，绝不写 group 成员库",
      "variant": "dashed"
    },
    {
      "id": "b4",
      "from": "memsvc",
      "to": "renderer",
      "y": 660,
      "label": "渲染按 1820 tok 出包",
      "variant": "default",
      "note": "service 侧 home 500 + 每成员 220；先贴 source 标签再计价"
    },
    {
      "id": "b5",
      "from": "memsvc",
      "to": "agent",
      "y": 698,
      "label": "返回结果；无命中返回固定文案 RECALL_NO_MATCH（该字节是指标契约）",
      "variant": "return"
    },
    {
      "id": "b6",
      "from": "agent",
      "to": "memsvc",
      "y": 740,
      "label": "memory_propose / memory_forget（principal-only，双谓词 isLiveAgent ∧ isLineagePrincipal）",
      "variant": "security"
    },
    {
      "id": "b7",
      "from": "memsvc",
      "to": "store",
      "y": 780,
      "label": "commitL1Mutation：BEGIN IMMEDIATE 单事务，唯一权威写入口",
      "variant": "emphasis"
    },
    {
      "id": "b8",
      "from": "store",
      "to": "memsvc",
      "y": 820,
      "label": "D9 触发器同事务删除整个派生层 + store_revision 自增",
      "variant": "security"
    },
    {
      "id": "c1",
      "from": "agent",
      "to": "pipeline",
      "y": 906,
      "label": "agent/turn-stopping 事件",
      "variant": "default"
    },
    {
      "id": "c2",
      "from": "pipeline",
      "to": "store",
      "y": 950,
      "label": "单事务内 captureTurn 写 L0 + 有条件 enqueueJob('extract')",
      "variant": "emphasis",
      "note": "L0 写入无条件；入队需两个闸门：llm 服务可用 且 turnTokens ≥ 200"
    },
    {
      "id": "c3",
      "from": "pipeline",
      "to": "agent",
      "y": 996,
      "label": "任何失败 fail open：只记 warn，绝不打断 turn 边界",
      "variant": "dashed"
    },
    {
      "id": "c4",
      "from": "pipeline",
      "to": "store",
      "y": 1042,
      "label": "JobRunner 每 30 秒 tick（脱离 turn 异步执行）：extract → reconcile → decay → rebuild",
      "variant": "dashed"
    }
  ],
